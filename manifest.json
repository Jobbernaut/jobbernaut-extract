{
  "manifest_version": 3,
  "name": "Jobbernaut Extract",
  "version": "1.0.0",
  "description": "Extract job application data and copy to clipboard in YAML format",
  "permissions": ["activeTab", "storage", "notifications", "contextMenus"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://www.ycombinator.com/*",
    "https://wellfound.com/*",
    "https://www.glassdoor.com/*",
    "https://www.monster.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content/shared-utils.js", "content/linkedin-scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.indeed.com/*"],
      "js": ["content/shared-utils.js", "content/indeed-scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.ycombinator.com/companies/*/jobs/*"],
      "js": ["content/shared-utils.js", "content/ycombinator-scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://wellfound.com/jobs/*"],
      "js": ["content/shared-utils.js", "content/wellfound-scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.glassdoor.com/Job/*"],
      "js": ["content/shared-utils.js", "content/glassdoor-scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.monster.com/*"],
      "js": ["content/shared-utils.js", "content/monster-scraper.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
